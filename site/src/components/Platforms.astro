---
//! A compact desktop support overview, after the README's status table.
//! Setup requirements and platform limits stay visible; the parity link has details.
import { onGitHub } from '../lib/repo';

type Status = 'Daily use' | 'Works';
const systems: { os: string; versions: string; client: Status; host: [Status, string] }[] = [
  {
    os: 'macOS',
    versions: '14 and later',
    client: 'Daily use',
    host: ['Works', 'Virtual display; no controllers yet'],
  },
  {
    os: 'Windows',
    versions: '10 and 11',
    client: 'Works',
    host: ['Daily use', 'Requires NVIDIA and SudoVDA'],
  },
  {
    os: 'Linux',
    versions: 'X11 and Wayland',
    client: 'Works',
    host: ['Works', 'No virtual display yet; no remote input on sway or Hyprland, work in progress.'],
  },
];
---

<section class="section" id="platforms">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Platforms</span>
      <h2 class="title">A client and host on every desktop</h2>
    </div>

    <div class="table-wrap">
      <table aria-label="Where Ping and Pong run">
        <thead>
          <tr>
            <th scope="col">System</th>
            <th scope="col">Client (Ping)</th>
            <th scope="col">Host (Pong)</th>
          </tr>
        </thead>
        <tbody>
          {systems.map((s) => (
            <tr>
              <th scope="row">
                {s.os}
                <span>{s.versions}</span>
              </th>
              <td>
                <span class:list={['status', s.client === 'Daily use' && 'daily']}>{s.client}</span>
              </td>
              <td>
                <span class:list={['status', s.host[0] === 'Daily use' && 'daily']}>{s.host[0]}</span>
                <p>{s.host[1]}</p>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note after">
      Phones, tablets and TVs are out of scope.
      <a href={onGitHub('docs/parity.md')}>Compare platform features</a>
    </p>
  </div>
</section>

<style>
  .table-wrap {
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 20px 24px;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  thead th {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  tbody tr + tr {
    border-top: 1px solid var(--line);
  }

  tbody th {
    width: 20%;
    color: var(--text);
    font-weight: 500;
  }

  tbody th span {
    display: block;
    margin-top: 2px;
    color: var(--text-3);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  td {
    width: 40%;
  }

  .status {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.75rem;
  }

  .status.daily {
    border-color: rgb(141 178 255 / 0.4);
    color: var(--accent);
  }

  td p {
    margin-top: 8px;
  }

  .after {
    margin-top: 16px;
  }

  @media (max-width: 640px) {
    th,
    td {
      padding: 14px 10px;
    }
  }
</style>
