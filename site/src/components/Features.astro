---
// What pingpong does beyond the stream itself. The words follow README.md,
// docs/parity.md, docs/networking.md and docs/usage.md.
import { TUNNEL } from '../lib/facts';

const features = [
  {
    title: 'Post-quantum encryption',
    text: `Picture, sound, input and the clipboard travel in one tunnel: WireGuard with ML-KEM-768. Pairing is a hybrid SPAKE2 + ML-KEM exchange over a PIN. Encrypting a 1,200-byte packet takes ${TUNNEL.encrypt1200}.`,
  },
  {
    title: 'Reach your host from anywhere',
    text: 'Hosts publish sealed records on the BitTorrent DHT, and both sides punch through their NATs. No relay server, no VPN and no ports to forward.',
  },
  {
    title: 'Recovery from packet loss',
    text: 'Reed-Solomon parity, sized to the loss the link shows, rebuilds what Wi-Fi drops. When it cannot, Ping asks for a fresh reference frame, as Moonlight does.',
  },
  {
    title: 'Your screen’s exact mode',
    text: 'Windows and macOS hosts create a virtual display at your screen’s resolution and refresh rate for the session, so nothing is scaled.',
  },
  {
    title: 'Sizes games fill',
    text: 'Ping asks for your screen’s size at the nearest standard aspect ratio, 16:10 below a MacBook’s notch, so a game fills the picture instead of leaving strips around it.',
  },
  {
    title: 'The host’s own pointer',
    text: 'The host draws its pointer into the picture, as Apollo does, and Ping sends the mouse’s relative motion, as Moonlight does: menus take the mouse, and a game that hides the pointer hides it.',
  },
  {
    title: 'A clipboard shared both ways',
    text: 'Text, images, files and folders, in either direction. Anything a password manager marks as concealed is never sent.',
  },
  {
    title: 'Surround sound and controllers',
    text: 'Stereo, 5.1 or 7.1 sound, from a Mac host too when it has a surround output. Controllers reach a Windows host as Xbox 360 pads, and rumble comes back about 7 ms after the host sets it.',
  },
  {
    title: 'Screenshots of your own screen',
    text: 'Your computer’s screenshot shortcuts stay yours while you stream, ⌘⇧4 and CleanShot X on a Mac, Print Screen and the Snipping Tool on Windows, with a pointer you can move.',
  },
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Features</span>
      <h2 class="title">Feature for feature with Moonlight and Apollo</h2>
      <p class="lede">
        pingpong covers what a Moonlight + Apollo setup does, and adds to it: one code base in Rust, with a client
        and a host on all three desktops.
      </p>
    </div>

    <ul class="grid">
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: 20px;
    border-top: 1px solid var(--line-2);
  }

  h3 {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  li p {
    margin-top: 8px;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
