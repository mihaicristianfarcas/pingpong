---
//! What pingpong does beyond the stream itself. The words follow README.md,
//! docs/parity.md, docs/networking.md and docs/usage.md.
import { TUNNEL } from '../lib/facts';

const features = [
  {
    title: 'Post-quantum encryption',
    text: `Picture, sound, input and the clipboard travel in one tunnel: WireGuard with ML-KEM-768. Pairing is a hybrid SPAKE2 + ML-KEM exchange over a PIN. Encrypting a 1,200-byte packet takes ${TUNNEL.encrypt1200}.`,
  },
  {
    title: 'Reach your host from anywhere',
    text: 'Hosts publish sealed records on the BitTorrent DHT, both sides punch through their NATs, and Ping shows a host online from wherever you are. No relay server or separate VPN; port forwarding may be needed when both sides have symmetric NAT.',
  },
  {
    title: 'Recovery from packet loss',
    text: 'Reed-Solomon parity, sized to the loss the link shows, rebuilds what Wi-Fi drops. When it cannot, Ping asks for a fresh reference frame, as Moonlight does.',
  },
  {
    title: 'HDR and 4:4:4 colour',
    text: 'HDR10 to a Mac with an HDR display, from a Windows host’s NVIDIA GPU or a Mac host, drawn with the host’s light levels as Moonlight does. 4:4:4 keeps coloured text and fine lines sharp, and Macs that decode AV1 can stream it.',
  },
  {
    title: 'Your screen’s exact mode',
    text: 'Windows and macOS hosts create a virtual display at your screen’s resolution and exact refresh rate, 59.94 Hz included, so nothing is scaled and no frame is dropped or repeated.',
  },
  {
    title: 'Input that feels local',
    text: 'The mouse moves the way games expect, held keys repeat at your own keyboard’s pace, and Moonlight’s shortcuts work. Swap the mouse buttons or reverse scrolling if you like.',
  },
  {
    title: 'A clipboard shared both ways',
    text: 'Text, images, files and folders, in either direction. Anything a password manager marks as concealed is never sent.',
  },
  {
    title: 'Surround sound and controllers',
    text: 'Stereo, 5.1 or 7.1 sound, from a Mac host too when it has a surround output. Controllers reach a Windows host as Xbox 360 pads, and rumble comes back about 7 ms after the host sets it.',
  },
  {
    title: 'A host set up for streaming',
    text: 'On a Windows host, Pong runs the NVIDIA GPU at full power, captures OpenGL and Vulkan games at their full frame rate and puts Wi-Fi in its streaming mode, as Sunshine does. Everything goes back afterwards.',
  },
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Features</span>
      <h2 class="title">An open-source alternative to Moonlight and Sunshine/Apollo</h2>
      <p class="lede">
        pingpong pairs its own client and host for remote desktop and game streaming. It follows the streaming behaviour of
        Moonlight and Sunshine/Apollo, and adds post-quantum encryption and a clipboard shared both ways, files
        included.
        Compare <a href="#platforms">platform support</a> and the
        <a href="#latency">measured latency</a> before choosing your setup.
      </p>
    </div>

    <ul class="grid">
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: 20px;
    border-top: 1px solid var(--line-2);
  }

  h3 {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  li p {
    margin-top: 8px;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Nine tiles in two columns: the last one takes the row. */
    li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
