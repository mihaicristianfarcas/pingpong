---
// AI agents on your hosts (docs/ai-agents.md): the real windows, what you
// keep control of, and the host's own rules.
import { Image } from 'astro:assets';
import { onGitHub } from '../lib/repo';
import ask from '../assets/shots/ping-ask.webp';

const rules = [
  ['Never over a person', 'An agent is refused while a person streams.'],
  ['A person always wins', 'Starting a stream takes over from an agent.'],
  ['Secure screens are a person’s', 'At a sign-in or lock screen, or a UAC prompt, its input is held.'],
  ['Someone at the host comes first', 'Input at the host holds the agent until 10 s after it stops.'],
];
---

<section class="section" id="agents">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">AI agents</span>
      <h2 class="title">Let an AI agent use your host</h2>
      <p class="lede">
        An agent sees the screen and uses the keyboard and mouse the way you do through Ping: over the same tunnel,
        from anywhere. You can watch it, take over or stop it at any point.
      </p>
    </div>

    <figure class="capture">
      <Image
        src={ask}
        alt="An agent session in Ping: the conversation about the Downloads folder, the agent waiting for a go-ahead to empty the Recycle Bin with Allow and Don't buttons, the screen it saw after its last step, and its plan."
        widths={[640, 960, 1280, 1880]}
        sizes="(max-width: 1168px) 94vw, 1120px"
      />
      <figcaption class="note">
        An agent session in Ping: the screen it saw after each step, its plan, and a go-ahead it waits for before it
        empties the Recycle Bin.
      </figcaption>
    </figure>

    <ul class="points">
      <li>
        <h3>Watch it, or take over</h3>
        <p>
          Every action, its result and the screen after it. Log in to see the desktop live; <kbd>Ctrl</kbd>
          <kbd>Alt</kbd>
          <kbd>Shift</kbd>
          <kbd>T</kbd> takes the keyboard and mouse.
        </p>
      </li>
      <li>
        <h3>It asks first</h3>
        <p>
          Before it deletes, spends, sends, installs or types a password. Rules catch <code>rm -rf</code>,
          <code>git push --force</code> and <code>DROP TABLE</code> whether it asked or not.
        </p>
      </li>
      <li>
        <h3>Your model, or your agent</h3>
        <p>
          Claude Code or Codex on your plan, an Anthropic, OpenAI or OpenRouter key, or a local model. Or give any MCP
          client your hosts as tools with <code>Ping mcp</code>.
        </p>
      </li>
    </ul>

    <div class="rules">
      <h3>Rules the host holds every agent to</h3>
      <ol>
        {rules.map(([title, body]) => (
          <li>
            <strong>{title}</strong>
            <span>{body}</span>
          </li>
        ))}
      </ol>
      <p class="note">
        An agent pairs like a device, and its role is sealed with the PIN’s key: the host knows it by its key, not by
        what it claims. <a href={onGitHub('docs/ai-agents.md')}>How agents work</a>
      </p>
    </div>
  </div>
</section>

<style>
  figcaption {
    margin-top: 14px;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    padding-top: 20px;
    border-top: 1px solid var(--line-2);
  }

  .points h3 {
    font-size: 1rem;
  }

  .points p {
    margin-top: 8px;
    font-size: 0.9375rem;
  }

  .rules {
    margin-top: clamp(48px, 6vw, 72px);
    padding: 28px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .rules h3 {
    font-size: 1rem;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 24px 0;
    padding: 0;
    list-style: none;
    counter-reset: rule;
  }

  ol li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.875rem;
    counter-increment: rule;
  }

  ol li::before {
    content: counter(rule);
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  ol strong {
    color: var(--text);
    font-weight: 500;
  }

  .rules > .note {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .points {
      grid-template-columns: 1fr;
    }

    ol {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    ol {
      grid-template-columns: 1fr;
    }

    .rules {
      padding: 22px;
    }
  }
</style>
