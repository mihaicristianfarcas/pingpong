---
//! Section navigation with a mobile disclosure and links to the FAQ.
import Logo from './Logo.astro';
import { REPO } from '../lib/repo';
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a href="#top" class="home" aria-label="pingpong, top of the page"><Logo /></a>
    <button type="button" class="menu" aria-expanded="false" aria-controls="sections" data-menu>Menu</button>
    <nav id="sections" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#latency">Latency</a>
      <a href="#agents">AI agents</a>
      <a href="#platforms">Platforms</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="end">
      <a class="gh" href={REPO} aria-label="Source on GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a class="button primary small" href="#install">Download</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(3 5 10 / 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--nav);
  }

  .home {
    flex-shrink: 0;
  }

  .home:hover {
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }

  nav a {
    padding-block: 8px;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gh {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--text-2);
  }

  .gh:hover {
    color: var(--text);
  }

  .small {
    height: 34px;
    padding: 0 14px;
    font-size: 0.875rem;
  }

  .menu {
    display: none;
  }

  /* A phone: the sections behind a Menu button, in a panel under the bar.
     Without script there is no button, and the links wrap onto a second
     row instead. */
  @media (max-width: 820px) {
    .bar {
      flex-wrap: wrap;
      gap: 8px 16px;
      height: auto;
      min-height: var(--nav);
      padding-block: 12px;
    }

    nav {
      order: 3;
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 4px 20px;
      margin-left: 0;
    }

    .end {
      margin-left: auto;
    }

    :global(.js) .bar {
      flex-wrap: nowrap;
      height: var(--nav);
      padding-block: 0;
    }

    :global(.js) .menu {
      display: inline-flex;
      align-items: center;
      height: 34px;
      margin-left: auto;
      padding: 0 12px;
      border: 1px solid var(--line-2);
      border-radius: var(--radius-sm);
      background: none;
      color: var(--text);
      font: inherit;
      font-size: 0.875rem;
      cursor: pointer;
    }

    :global(.js) .end {
      margin-left: 0;
    }

    :global(.js) nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      border-bottom: 1px solid var(--line);
      background: rgb(3 5 10 / 0.97);
    }

    :global(.js) nav[data-open] {
      display: flex;
    }

    :global(.js) nav a {
      padding: 12px 0;
      font-size: 1rem;
    }
  }

  /* The narrowest phones: the source link stays in the footer. */
  @media (max-width: 380px) {
    .gh {
      display: none;
    }
  }
</style>

<script>
  // The phone's menu: a disclosure. Escape, a link, or a click elsewhere
  // closes it; Escape gives the focus back to the button.
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const nav = header.querySelector<HTMLElement>('nav')!;
  const open = (on: boolean) => {
    nav.toggleAttribute('data-open', on);
    button.setAttribute('aria-expanded', String(on));
  };
  button.addEventListener('click', () => open(!nav.hasAttribute('data-open')));
  nav.addEventListener('click', (e) => (e.target as Element).closest('a') && open(false));
  document.addEventListener('click', (e) => !header.contains(e.target as Node) && open(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
      open(false);
      button.focus();
    }
  });
  window.matchMedia('(min-width: 821px)').addEventListener('change', () => open(false));
</script>
