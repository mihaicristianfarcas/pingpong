---
// One of the apps' own icons (pingpong-ui/assets/icons/): 24x24, 1.75 pt
// round strokes in currentColor, so they take the text's colour here too.
const icons = import.meta.glob<string>('../../../pingpong-ui/assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className } = Astro.props;
const svg = icons[`../../../pingpong-ui/assets/icons/${name}.svg`];
if (!svg) throw new Error(`pingpong-ui has no icon named "${name}"`);

const html = svg.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} `,
);
---

<Fragment set:html={html} />
