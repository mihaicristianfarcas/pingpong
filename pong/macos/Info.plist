<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Pong</string>
	<key>CFBundleDisplayName</key>
	<string>Pong</string>
	<!-- Screen Recording and Accessibility are granted to this identity, so
	     they follow the app rather than whichever terminal started it. -->
	<key>CFBundleIdentifier</key>
	<string>dev.pingpong.Pong</string>
	<key>CFBundleExecutable</key>
	<string>pong</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both versions are set to the workspace's by tools/build-pong-app. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<!-- The Privacy & Security lists and Login Items show it. -->
	<key>CFBundleIconFile</key>
	<string>Pong</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Mihai-Cristian Farcaș. GPL-3.0 License.</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- A background host: no Dock icon, no menu bar. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Asked the first time a client wants sound in surround: a Core
	     Audio tap of the output device (pong/src/mac/sound.rs). -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Pong streams this Mac's sound in surround to the device you stream to.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pong streams this Mac to the devices you pair with it on your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pingpong._udp</string>
	</array>
</dict>
</plist>
