#!/usr/bin/env bash
# A sandboxed Linux desktop for AI agents to use, in a container: Xvfb with
# openbox, a panel, a terminal, a text editor, a calculator and a file
# manager, streamed by Linux Pong. This device's agent identity is paired
# with it by hand, and so is a person's (for watching). Run from the Mac:
#
#   tools/linux/agent-desktop start     build, start the desktop and Pong
#   tools/linux/agent-desktop mcp ...   the MCP server, over docker exec (for agents)
#   tools/linux/agent-desktop exec CMD  run CMD in the container (DISPLAY=:1)
#   tools/linux/agent-desktop shot [F]  the X screen as PNG (default target/linux-out/agent/x.png)
#   tools/linux/agent-desktop stop
#
# Data and logs: target/linux-out/agent (pong/, ping/, pong.log, desktop.log).
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
NAME=pingpong-agent-desktop
OUT=/src/target/linux-out/agent
SIZE=${AGENT_DESKTOP_SIZE:-1280x800}

inside() { docker exec -i -e DISPLAY=:1 -e PONG_DATA_DIR=$OUT/pong -e PING_DATA_DIR=$OUT/ping -e NO_COLOR=1 "$NAME" "$@"; }

case "${1:-}" in
start)
    docker build -q -t pingpong-linux "$REPO/tools/linux" >/dev/null
    "$REPO/tools/linux-dev" cargo build -q -p pong -p ping-agent -p ping-core --bin pong --bin pongctl --bin ping-agent --bin pingctl
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker run -d --name "$NAME" \
        -v "$REPO":/src -w /src \
        -v pingpong-linux-target:/target -e CARGO_TARGET_DIR=/target \
        -v pingpong-linux-registry:/root/.cargo/registry \
        pingpong-linux sleep infinity >/dev/null
    inside bash -c "
        set -e
        rm -rf $OUT; mkdir -p $OUT/pong $OUT/ping $OUT/home/Documents
        cat >$OUT/pong/config.toml <<TOML
name = \"linux-desk\"
port = 47820
pairing_port = 47821
web_port = 47822
internet_access = false
TOML
        printf 'Groceries\n- milk\n- eggs\n' >$OUT/home/Documents/list.txt
        (Xvfb :1 -screen 0 ${SIZE}x24 -nolisten tcp >$OUT/xvfb.log 2>&1 &)
        sleep 1
        export HOME=$OUT/home
        (openbox >$OUT/desktop.log 2>&1 &)
        (tint2 >>$OUT/desktop.log 2>&1 &)
        (cd $OUT/home && xterm -geometry 90x24+40+60 -title Terminal >>$OUT/desktop.log 2>&1 &)
        sleep 1
        # Pair by hand: the agent (as an agent) and a person, both ways.
        host=\$(/target/debug/pongctl identity | sed -E 's/.*= \"(.*)\"/\\1/' | paste -sd' ')
        /target/debug/pongctl add-client 'test agent' \$(/target/debug/ping-agent identity) --agent >/dev/null
        /target/debug/pongctl add-client 'test person' \$(/target/debug/pingctl identity) >/dev/null
        /target/debug/ping-agent add-host linux-desk 127.0.0.1:47820 \$host
        /target/debug/pingctl add-host linux-desk 127.0.0.1:47820 \$host
        (HOME=$OUT/home RUST_LOG=info,mainline=error /target/debug/pong host >$OUT/pong.log 2>&1 &)
        sleep 2
    "
    echo "desktop up; agent MCP: tools/linux/agent-desktop mcp --host linux-desk"
    ;;
mcp)
    shift
    exec docker exec -i -e PING_DATA_DIR=$OUT/ping -e RUST_LOG="${RUST_LOG:-warn,ping_agent=info}" "$NAME" /target/debug/ping-agent mcp "$@"
    ;;
exec)
    shift
    inside "$@"
    ;;
shot)
    f=${2:-target/linux-out/agent/x.png}
    inside bash -c "rm -f /tmp/x.png; scrot -o /tmp/x.png && cp /tmp/x.png /src/$f"
    echo "$REPO/$f"
    ;;
stop)
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    ;;
*)
    sed -n 2,14p "$0"
    exit 1
    ;;
esac
